# Server Configuration
PORT=8000
APP_ENV=production
APP_BASE_URL=http://localhost:8000

# Data & Concurrency (Render Free 512MB RAM safe defaults)
DATA_DIR=./data
MAX_CONCURRENT_JOBS=1
MAX_UPLOAD_MB=500

# Encryption Secret for stored API keys & OAuth tokens (Fernet 32-byte url-safe base64 key or passphrase)
# In production (Render), set a strong random value so keys survive container restarts when using persistent disk.
ENCRYPTION_SECRET=change-this-to-a-strong-random-secret-in-production

# Google Drive OAuth 2.0 (Optional: can also be configured in the UI Settings screen)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/drive/oauth/callback

# Optional AI Provider API Keys (Recommended: enter via UI Settings so keys are encrypted at rest)
# Never commit real keys to version control!
OPENROUTER_API_KEY=
GEMINI_API_KEY=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
OPENAI_API_KEY=
